# Supply chain hardening (see SUPPLY_CHAIN_SECURITY.md)

# Release age gating — reject packages published less than 7 days ago
publish-time-gate=10080

# Disable install scripts by default (use onlyBuiltDependencies to allow-list)
ignore-scripts=true

# Block git-based / tarball dependencies from transitive deps
block-exotic-subdependencies=true

# Trust policy — fail if a package's trust level decreased vs previous release
trust-policy=no-downgrade
